rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && userDoc().role == 'admin';
    }

    function isPortalUser() {
      return isAuth() && exists(/databases/$(database)/documents/proveedoresPortal/$(request.auth.uid));
    }

    function canRead(section) {
      let u = userDoc();
      return u.role == 'admin' || u.permissions.get(section, 'none') in ['read', 'write'];
    }

    function canWrite(section) {
      let u = userDoc();
      return u.role == 'admin' || u.permissions.get(section, 'none') == 'write';
    }

    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']));
      allow delete: if isAdmin();
    }

    match /clientes/{id} {
      allow read: if isAuth() && canRead('clientes');
      allow write: if isAuth() && canWrite('clientes');
      match /movimientos/{mId} {
        allow read: if isAuth() && canRead('clientes');
        allow write: if isAuth() && canWrite('movimientos');
      }
    }

    match /proveedores/{id} {
      allow read: if isAuth() && canRead('proveedores');
      allow write: if isAuth() && canWrite('proveedores');
      match /movimientos/{mId} {
        allow read: if isAuth() && canRead('proveedores');
        allow write: if isAuth() && canWrite('movimientos');
      }
    }

    match /empleados/{id} {
      allow read: if isAuth() && canRead('empleados');
      allow write: if isAuth() && canWrite('empleados');
      match /sueldos/{sId} {
        allow read: if isAuth() && canRead('empleados');
        allow write: if isAuth() && canWrite('empleados');
      }
    }

    match /insumos/{id} {
      allow read: if isAuth() && canRead('insumos');
      allow write: if isAuth() && canWrite('insumos');
      match /precios/{pId} {
        allow read: if isAuth() && canRead('insumos');
        allow write: if isAuth() && canWrite('insumos');
      }
    }

    match /productos/{id} {
      allow read: if isAuth() && (canRead('productos') || isPortalUser());
      allow write: if isAuth() && canWrite('productos');
      match /receta/{rId} {
        allow read: if isAuth() && canRead('productos');
        allow write: if isAuth() && canWrite('productos');
      }
    }

    match /movimientos/{id} {
      allow read: if isAuth() && canRead('movimientos');
      allow write: if isAuth() && canWrite('movimientos');
    }

    match /cuentas/{id} {
      allow read: if isAuth() && canRead('cuentas');
      allow write: if isAuth() && canWrite('cuentas');
      match /movimientos/{mId} {
        allow read: if isAuth() && canRead('cuentas');
        allow write: if isAuth() && canWrite('movimientos');
      }
    }

    match /stock/{id} {
      allow read: if isAuth() && canRead('stock');
      allow write: if isAuth() && canWrite('stock');
    }

    match /stockMovimientos/{id} {
      allow read: if isAuth() && canRead('stock');
      allow write: if isAuth() && canWrite('stock');
    }

    match /produccion/{id} {
      allow read: if isAuth() && canRead('stock');
      allow write: if isAuth() && canWrite('stock');
    }

    match /categorias/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /listasPrecios/{id} {
      allow read: if isAuth();
      allow write: if isAuth() && canWrite('config');
    }

    match /modosVenta/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Portal collections ───────────────────────────────────────────────────

    match /proveedoresPortal/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && (request.auth.uid == uid || isAdmin());
    }

    match /portalSubClientes/{id} {
      allow read, write: if isAuth() && (
        resource == null
          ? request.resource.data.ownerUID == request.auth.uid
          : resource.data.ownerUID == request.auth.uid || isAdmin()
      );
    }

    match /pedidos/{id} {
      allow read: if isAuth() && (
        resource.data.ownerUID == request.auth.uid || isAdmin() || canRead('pedidos')
      );
      allow create: if isAuth() && request.resource.data.ownerUID == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerUID == request.auth.uid || isAdmin() || canWrite('pedidos')
      );
      allow delete: if isAuth() && (
        resource.data.ownerUID == request.auth.uid || isAdmin()
      );
    }

    match /pedidosPlantillas/{id} {
      allow read, write: if isAuth() && (
        resource == null
          ? request.resource.data.ownerUID == request.auth.uid
          : resource.data.ownerUID == request.auth.uid
      );
    }
  }
}
